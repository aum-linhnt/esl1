APP_NAME="ESL LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://127.0.0.1:8000
APP_PORT=8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=esl
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6393

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro

SPEECH_AI_URL=https://speechai.lmsviet.com

# AI Tutor — enable only after migrations, provider, entitlements and credit setup.
# This switch does not provision credit accounts or pricing rules.
AI_TUTOR_ENABLED=false
AI_BILLING_MODE=customer_key
AI_DEFAULT_PROVIDER=openai
# Choose model IDs available to your OpenAI account; empty values fail closed.
# phù hợp hội thoại gia sư có prompt rõ ràng, chi phí thấp và độ trễ tốt hơn model lớn. OpenAI Docs – GPT-5 mini
AI_DEFAULT_CHAT_MODEL=gpt-5-mini
# phù hợp tạo vector Knowledge và tìm kiếm RAG với chi phí thấp. OpenAI Docs – Embeddings
AI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# AI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-large (Nếu ưu tiên chất lượng tìm kiếm cao hơn chi phí)
# Sau khi đổi model embedding, cần tạo lại vector cho toàn bộ Knowledge; không nên trộn vector từ hai model khác nhau.
AI_TUTOR_MAX_OUTPUT_TOKENS=4000
AI_TUTOR_REASONING_EFFORT=low
OPENAI_API_KEY=
AI_DAILY_CREDITS=10
# GEMINI_API_KEY is declared above; the AI Tutor runtime currently implements OpenAI only.

# License: server = signed license required (package default).
# source_owned = explicit source purchase, no online verification or remote revocation.
# Existing source-owned selection is preserved here. Unknown/empty modes deny access.
AI_LICENSE_MODE=source_owned
AI_LICENSE_SOURCE_MODULES=ai_tutor_core,ai_tutor_knowledge
# The following settings are used only in server mode. Never commit real keys.
AI_LICENSE_SERVER_URL=
AI_LICENSE_KEY=
# Leave empty to initialize/persist an installation ID and derive domain from APP_URL.
AI_LICENSE_INSTALLATION_ID=
AI_LICENSE_DOMAIN=
AI_LICENSE_PUBLIC_KEY_ID=license-key-2026-01
AI_LICENSE_PUBLIC_KEY_PATH=
AI_LICENSE_REFRESH_HOURS=24
AI_LICENSE_GRACE_DAYS=7

# Lesson widget: bottom-right|bottom-left; drawer|floating_panel|full_page.
AI_TUTOR_LAUNCHER_POSITION=bottom-right
AI_TUTOR_LESSON_CHAT_MODE=drawer
# Valid desktop width: 320–640 px. Mobile uses fullscreen automatically.
AI_TUTOR_DESKTOP_PANEL_WIDTH=420
AI_TUTOR_ALLOW_EXPAND_TO_PAGE=true

# Retention is destructive when enabled; keep OFF until the policy is approved.
AI_CONVERSATION_RETENTION_ENABLED=false
AI_CONVERSATION_RETENTION_DAYS=365

# Knowledge worker: queue:work --queue=ai-tutor-knowledge,default --timeout=60 --tries=3
# retry_after must exceed the worker timeout; QUEUE_CONNECTION is declared above.
DB_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_RETRY_AFTER=90
